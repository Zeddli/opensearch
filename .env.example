# Copy to .env.local (or .env).
# AI keys are NOT configured here: each user adds their own AI API key (Anthropic or any OpenAI-compatible endpoint) in Settings.
# Platform integrations below are optional; when missing, the feature is disabled with a clear message.

# empty -> embedded PGlite at ./.data/pglite
DATABASE_URL=
SESSION_SECRET=dev-secret-change-me
# Encrypts secrets at rest (users' AI keys, Shopify tokens). Use a long random value in production;
# changing it makes stored keys unreadable (users must re-enter them).
APP_ENCRYPTION_KEY=dev-key-change-me

# PayPal sandbox platform app: REQUIRED for payments (checkout, saved-PayPal auto-pay, seller onboarding).
# Empty -> payments are disabled (payment routes answer 503 "PayPal is not configured on this server").
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_BN_CODE=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# 300 bps = 3%
PLATFORM_FEE_BPS=300

# Channel3 public-web price comparison. Empty -> comparison unavailable.
CHANNEL3_API_KEY=

NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
OFFER_WINDOW_SECONDS=45
# Public URL of this app (PayPal return URLs; also sent to OpenRouter as the HTTP-Referer attribution header).
APP_URL=http://localhost:3000

# Optional PayPal tuning
PAYPAL_WEBHOOK_ID=            # set to verify webhook signatures
PAYPAL_VAULT_USAGE_TYPE=PLATFORM   # PLATFORM or MERCHANT
PAYPAL_VAULT_ON_POPUP=1       # 0 = don't try to save PayPal on popup payments
